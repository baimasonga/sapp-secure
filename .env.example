# Salone Shield — environment template
#
# Copy to `.env` (git-ignored) and fill in per environment. Values are passed
# to the build with --dart-define-from-file=.env, never read from disk at
# runtime and never committed.
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# The app runs fully without any of these: message analysis, screenshot
# scanning, link checking and identity verification are all local-only.

# development | staging | production
APP_ENV=development

# Supabase project. Use a separate project per environment.
# ONLY the anon/publishable key belongs here. The service-role key must never
# be placed in a mobile build — it bypasses row-level security.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Feature flags. Everything that sends data off the device is off by default.
ENABLE_ANALYTICS=false
ENABLE_NOTIFICATION_MONITORING=false
ENABLE_EXTERNAL_URL_REPUTATION=false

# Community reporting (accounts, submissions, moderation).
# Do NOT enable for an environment until the row-level security test plan in
# docs/SUPABASE_SETUP.md has been run against that environment's project.
ENABLE_REPORTING=false
